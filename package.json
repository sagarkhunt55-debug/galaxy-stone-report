{
  "name": "galaxy-stone-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "build": {
    "appId": "com.galaxystone.app",
    "productName": "Galaxy Stone Report",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}